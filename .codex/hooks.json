{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node 'c:\\st8-workspace\\.codex\\hooks\\gsd-prompt-guard.js'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node 'c:\\st8-workspace\\.codex\\hooks\\gsd-read-guard.js'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node 'c:\\st8-workspace\\.codex\\hooks\\gsd-workflow-guard.js'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'c:\\st8-workspace\\.codex\\hooks\\gsd-validate-commit.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'c:\\st8-workspace\\.codex\\hooks\\pre-commit-security.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node 'c:\\st8-workspace\\.codex\\hooks\\gsd-context-monitor.js'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'c:\\st8-workspace\\.codex\\hooks\\gsd-phase-boundary.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node 'c:\\st8-workspace\\.codex\\hooks\\gsd-check-update.js'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash 'c:\\st8-workspace\\.codex\\hooks\\gsd-session-state.sh'"
          }
        ]
      }
    ]
  }
}
